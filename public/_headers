# Cloudflare Pages response headers (copied to dist/ by Vite).
# HTML and version.json must always be revalidated so a new deployment is
# picked up immediately; hashed bundles in /assets/ never change and can be
# cached forever.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/version.json
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
